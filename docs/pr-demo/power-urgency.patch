diff --git a/tests/power-browser.spec.ts b/tests/power-browser.spec.ts
new file mode 100644
index 0000000..4ad9159
--- /dev/null
+++ b/tests/power-browser.spec.ts
@@ -0,0 +1,44 @@
+import { test, expect } from '@playwright/test';
+
+test('urgent power badge, exact counts, intersecting filters and repair/resolve/reopen', async ({ page, request }) => {
+  const incidents = await (await request.get('/api/incidents')).json();
+  const screen = incidents.find((incident: { assetTag: string }) => incident.assetTag === 'DEMO-CB-202');
+  const screenCount = screen.priority === 'urgent' ? 1 : 0;
+  const urgentCount = String(1 + screenCount);
+  await page.goto('/');
+  await expect(page.locator('#urgent-count')).toHaveText(urgentCount);
+  const row = page.locator('[data-incident-id="10000000-0000-4000-8000-000000000001"]');
+  await expect(row.locator('.priority')).toHaveText('Urgent');
+  await expect(page.locator('[data-incident-id="10000000-0000-4000-8000-000000000005"] .priority')).toHaveText('Standard');
+  await page.getByLabel('Filter by priority', { exact: true }).selectOption('urgent');
+  await expect(page.locator('#incidents > li')).toHaveCount(1 + screenCount);
+  await page.getByLabel('Filter by school', { exact: true }).selectOption('north');
+  await expect(page.locator('#incidents > li')).toHaveCount(1);
+  await expect(page.locator('#urgent-count')).toHaveText(urgentCount);
+  await page.getByLabel('Filter by school', { exact: true }).selectOption('west');
+  await expect(page.locator('#empty')).toBeVisible();
+  await page.getByLabel('Filter by school', { exact: true }).selectOption('all');
+  await page.getByLabel('Filter by status', { exact: true }).selectOption('resolved');
+  await expect(page.locator('#empty')).toBeVisible();
+  await page.getByLabel('Filter by status', { exact: true }).selectOption('all');
+  await page.getByLabel('Filter by priority', { exact: true }).selectOption('all');
+  try {
+    await row.getByRole('button', { name: 'Start repair DEMO-CB-101', exact: true }).click();
+    await expect(page.locator('#urgent-count')).toHaveText(urgentCount);
+    await row.getByRole('button', { name: 'Resolve DEMO-CB-101', exact: true }).click();
+    await expect(row.locator('.priority')).toHaveText('Standard');
+    await expect(page.locator('#urgent-count')).toHaveText(String(screenCount));
+    await row.getByRole('button', { name: 'Reopen DEMO-CB-101', exact: true }).click();
+    await expect(row.locator('.priority')).toHaveText('Urgent');
+    await expect(page.locator('#urgent-count')).toHaveText(urgentCount);
+  } finally {
+    const current = (await (await request.get('/api/incidents')).json()).find((incident: { assetTag: string }) => incident.assetTag === 'DEMO-CB-101');
+    if (current.status === 'in-repair') {
+      expect((await request.patch(`/api/incidents/${current.id}`, { data: { status: 'resolved' } })).ok()).toBe(true);
+      expect((await request.patch(`/api/incidents/${current.id}`, { data: { status: 'open' } })).ok()).toBe(true);
+    } else if (current.status === 'resolved') {
+      expect((await request.patch(`/api/incidents/${current.id}`, { data: { status: 'open' } })).ok()).toBe(true);
+    }
+  }
+  expect(await page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth)).toBe(false);
+});
diff --git a/tests/power-priority.test.ts b/tests/power-priority.test.ts
new file mode 100644
index 0000000..9a9e9bf
--- /dev/null
+++ b/tests/power-priority.test.ts
@@ -0,0 +1,34 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import request from 'supertest';
+import { createApp } from '../src/app.js';
+import { incidentStatuses, MemoryIncidentStore, presentIncident, sampleIncidents } from '../src/store.js';
+
+test('power policy is urgent only while unresolved; unrelated categories remain Standard', () => {
+  const fixture = sampleIncidents();
+  const power = fixture.find((incident) => incident.category === 'power')!;
+  for (const status of incidentStatuses) {
+    assert.equal(presentIncident({ ...power, status }).priority, status === 'resolved' ? 'standard' : 'urgent');
+  }
+  for (const category of ['keyboard', 'connectivity'] as const) {
+    for (const status of incidentStatuses) assert.equal(presentIncident({ ...power, category, status }).priority, 'standard');
+  }
+  assert.equal(fixture.filter((incident) => incident.category === 'power' && presentIncident(incident).priority === 'urgent').length, 1);
+});
+
+test('power priority is consistent on create, list, repair, resolution and reopening', async () => {
+  const store = new MemoryIncidentStore();
+  const app = createApp(store, { title: 'Classroom Ready', commit: 'power-pr', integrationSecret: 'fake', localDemo: true });
+  const body = { schoolId: 'north', assetTag: 'DEMO-POWER-PR', deviceType: 'chromebook', category: 'power' };
+  const created = (await request(app).post('/api/incidents').send(body).expect(201)).body;
+  assert.equal(created.priority, 'urgent');
+  const original = (await store.list()).find((incident) => incident.id === created.id)!;
+  const saved = (await request(app).get('/api/incidents').expect(200)).body.find((incident: { id: string }) => incident.id === created.id);
+  assert.equal(saved.priority, 'urgent');
+  assert.deepEqual((await store.list()).find((incident) => incident.id === created.id), original);
+  assert.ok(!('priority' in original));
+  for (const [status, priority] of [['in-repair', 'urgent'], ['resolved', 'standard'], ['open', 'urgent']]) {
+    const updated = (await request(app).patch(`/api/incidents/${created.id}`).send({ status }).expect(200)).body;
+    assert.equal(updated.priority, priority);
+  }
+});
